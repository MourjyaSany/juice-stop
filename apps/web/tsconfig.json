{
  "extends": "@juice-stop/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "next.config.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  // `scripts/` runs standalone under Node's native type stripping, which requires explicit .ts
  // import extensions — the opposite of what the bundler config allows. It is tooling, not app
  // code, and does not belong in the Next.js type program.
  "exclude": ["node_modules", "scripts"]
}
