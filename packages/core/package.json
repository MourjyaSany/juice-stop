{
  "name": "@juice-stop/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure domain primitives — money, business dates, results. Zero runtime dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@juice-stop/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
