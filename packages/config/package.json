{
  "name": "@juice-stop/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared build and lint configuration — tsconfig presets, ESLint flat configs, Tailwind preset.",
  "files": ["tsconfig", "eslint", "tailwind"],
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint/*": "./eslint/*.js",
    "./tailwind": "./tailwind/preset.js"
  },
  "scripts": {
    "lint": "echo \"@juice-stop/config: nothing to lint\"",
    "typecheck": "echo \"@juice-stop/config: no sources\"",
    "clean": "rimraf .turbo"
  }
}
