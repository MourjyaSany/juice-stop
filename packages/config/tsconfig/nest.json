{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Juice Stop — NestJS application",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    // Keep the incremental cache INSIDE dist. nest-cli's `deleteOutDir` removes dist but would
    // leave a cache file outside it, after which tsc believes everything is up to date and emits
    // almost nothing into the now-empty directory. Co-locating them keeps the two in sync.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "isolatedModules": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
