// ═════════════════════════════════════════════════════════════════════════════════════════════════
//  JUICE STOP — database schema (SQLite)
//
//  Docker was removed from the project, so Postgres went with it. SQLite gives us a real
//  database — real migrations, real constraints, real persistence — as a single file on disk with
//  zero infrastructure.
//
//  What SQLite costs us versus the Postgres design in docs/02-data-model.md, and how each is
//  handled:
//
//    · No enums          → CHECK-style discipline in app code + `@default` values. The allowed
//                          values live in packages/core so they cannot drift.
//    · No native arrays  → stored as JSON text and parsed at the repository boundary.
//    · No PostGIS        → not needed. We deliver to one complex; serviceability is a block
//                          lookup, not a polygon query (see apps/web/src/data/blocks.ts).
//    · No generated cols → businessDate is computed by the app via toBusinessDate() (ADR-010),
//                          which is the same function the frontend uses.
//    · No citext         → emails are lower-cased on write.
//
//  Money remains BigInt paise throughout (ADR-003). SQLite stores it as INTEGER, which is 64-bit
//  — the invariant survives the move intact.
// ═════════════════════════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
//  PLATFORM
// ─────────────────────────────────────────────────────────────────────────────────────────────────

model Outlet {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  phone     String?
  email     String?
  address   String?
  gstin     String?
  fssaiNo   String?  @map("fssai_license_no")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories Category[]
  products   Product[]
  orders     Order[]

  @@map("outlets")
}

/// Runtime configuration — store hours, capacity thresholds, feature flags.
/// `value` is JSON text; the typed accessors live in the platform module.
model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Append-only. Every privileged action lands here (README §3 invariant 10).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      String?
  after       String?
  ipAddress   String?  @map("ip_address")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Transactional outbox (ADR-006) — side effects emitted only for committed transactions.
model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       String
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Mobile networks retry. We must not create two orders or two refunds.
model IdempotencyKey {
  key              String   @id
  userId           String?  @map("user_id")
  endpoint         String
  requestHash      String   @map("request_hash")
  responseSnapshot String?  @map("response_snapshot")
  statusCode       Int?     @map("status_code")
  status           String   @default("IN_PROGRESS")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
//  IDENTITY
// ─────────────────────────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  phoneE164       String?   @unique @map("phone_e164")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  /// Lower-cased on write — SQLite has no citext.
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  fullName        String?   @map("full_name")
  /// CUSTOMER | KITCHEN | RIDER | ADMIN | SUPER_ADMIN
  role            String    @default("CUSTOMER")
  status          String    @default("ACTIVE")
  isGuest         Boolean   @default(false) @map("is_guest")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  addresses Address[]
  orders    Order[]

  @@index([status])
  @@map("users")
}

/// Every address is inside Abode Valley Complex; only `block` varies, constrained to a known set.
model Address {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  label        String    @default("Home")
  block        String
  flatOrRoom   String    @map("flat_or_room")
  floor        String?
  landmark     String?
  contactName  String    @map("contact_name")
  contactPhone String    @map("contact_phone")
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
//  CATALOG
// ─────────────────────────────────────────────────────────────────────────────────────────────────

model Category {
  id        String    @id
  outletId  String    @map("outlet_id")
  /// food | snacks | drinks | combos — the top-level navigation grouping.
  groupId   String    @map("group_id")
  name      String
  emoji     String    @default("🍽️")
  note      String?
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([outletId, groupId, sortOrder])
  @@map("categories")
}

model Product {
  id              String    @id
  outletId        String    @map("outlet_id")
  categoryId      String    @map("category_id")
  name            String
  description     String?
  isVeg           Boolean   @default(true) @map("is_veg")
  /// Drives the honest ETA (ADR-013).
  prepTimeSeconds Int       @default(420) @map("prep_time_seconds")
  /// JSON array of tag strings — SQLite has no native arrays.
  tagsJson        String    @default("[]") @map("tags_json")
  /// The kitchen's availability switch. False = the customer sees "Sold out".
  inStock         Boolean   @default(true) @map("in_stock")
  /// Remaining portions. NULL means unlimited — the common case, and the reason this is nullable
  /// rather than a sentinel like -1 that every read would have to remember to special-case.
  /// Reaching 0 flips `inStock` false; the two are kept consistent in one service method so they
  /// cannot disagree.
  stockRemaining  Int?      @map("stock_remaining")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  outlet   Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  addOns   ProductAddOn[]

  @@index([outletId, categoryId, sortOrder])
  @@map("products")
}

model ProductVariant {
  id         String  @id
  productId  String  @map("product_id")
  name       String
  /// Integer paise. Never a float, never rupees (ADR-003).
  pricePaise BigInt  @map("price_paise")
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

/// Add-ons whose price can depend on the chosen size (extra cheese is 40/60/70 by pizza size).
model ProductAddOn {
  id                  String  @id
  productId           String  @map("product_id")
  name                String
  /// Flat price when the add-on does not scale with size.
  pricePaise          BigInt? @map("price_paise")
  /// JSON map of variantId → paise, for size-dependent pricing.
  priceByVariantJson  String? @map("price_by_variant_json")
  isAvailable         Boolean @default(true) @map("is_available")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_add_ons")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
//  ORDERING
// ─────────────────────────────────────────────────────────────────────────────────────────────────

model Order {
  id          String   @id @default(cuid())
  outletId    String   @map("outlet_id")
  orderNumber String   @unique @map("order_number")
  /// Computed by the app via toBusinessDate() — the service day crosses midnight (ADR-010).
  businessDate String  @map("business_date")
  userId      String?  @map("user_id")

  /// PLACED | ACCEPTED | PREPARING | READY | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  status      String   @default("PLACED")

  /// DELIVERY | TAKEAWAY. Defaulted so the column is additive over existing rows.
  fulfilmentType String @default("DELIVERY") @map("fulfilment_type")

  /// Immutable copy of the address at placement. Null for takeaway — there is nowhere to deliver.
  addressJson String?  @map("address_json")

  /// Short collection code for takeaway, shown to the customer and quoted at the counter.
  /// Server-generated: a client-minted token proves nothing, exactly like the delivery OTP.
  pickupToken String?  @map("pickup_token")

  subtotalPaise    BigInt @map("subtotal_paise")
  deliveryFeePaise BigInt @default(0) @map("delivery_fee_paise")
  handlingFeePaise BigInt @default(0) @map("handling_fee_paise")
  taxPaise         BigInt @default(0) @map("tax_paise")
  totalPaise       BigInt @map("total_paise")

  /// UPI | COD. Card, net banking and wallet are gone — none was ever connected to a gateway.
  paymentMethod String  @map("payment_method")
  /// PENDING | PAID | EXPIRED | FAILED.
  ///
  /// No longer a constant. UPI settles before the kitchen sees the ticket; COD settles at the
  /// doorstep. This column is what keeps those two honest, and what the "cash to collect" figure
  /// on the owner dashboard is derived from.
  paymentStatus String  @default("PENDING") @map("payment_status")

  /// Our own reference for the payment request — alphanumeric, carried in the UPI `tr` field.
  /// Recognisable beside the order number on a bank statement, which is the whole job it has when
  /// confirmation is a human reading their banking app.
  paymentReference   String?   @map("payment_reference")
  /// When the UPI request was minted, and when it lapses. Expiry is evaluated on read rather than
  /// swept by a job — there is still no worker process (audit A7).
  paymentRequestedAt DateTime? @map("payment_requested_at")
  paymentExpiresAt   DateTime? @map("payment_expires_at")
  /// When the money actually arrived. Null until it has.
  paidAt             DateTime? @map("paid_at")
  /// Who or what confirmed it — a staff username for manual confirmation, or a provider id once a
  /// gateway webhook is the authority. Written so "who said this was paid?" is always answerable.
  paymentConfirmedBy String?   @map("payment_confirmed_by")
  /// The bank/provider's own reference — a UTR for UPI. Optional because a cook confirming from a
  /// notification may not have it to hand, and demanding it would make the fast path slow.
  paymentProviderRef String?   @map("payment_provider_ref")

  placedAt      DateTime @default(now()) @map("placed_at")
  /// When `status` last changed. Stored rather than derived from the event log because the
  /// customer's countdown restarts on every transition and would otherwise need a join per order
  /// on every poll. `updatedAt` cannot serve: it also moves for edits and confirm-now.
  statusChangedAt DateTime @default(now()) @map("status_changed_at")
  /// End of the 10-minute customer grace window; the kitchen holds until it passes.
  editableUntil DateTime @map("editable_until")
  /// The honest ETA we grade ourselves against.
  promisedAt    DateTime @map("promised_at")
  deliveredAt   DateTime? @map("delivered_at")

  /// Who to call out when the bag is ready. For delivery this duplicates the address contact by
  /// design — the kitchen must not have to parse an address blob to read a name off a ticket, and
  /// takeaway has no address at all.
  customerName String? @map("customer_name")
  customerPhone String? @map("customer_phone")

  prepSeconds  Int    @default(0) @map("prep_seconds")
  editCount    Int    @default(0) @map("edit_count")
  customerNote String? @map("customer_note")
  /// sha256 of the delivery OTP — the plaintext is never stored.
  otpHash      String @map("otp_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// Optimistic lock: two admins, one order, no lost update.
  version   Int      @default(0)

  outlet Outlet            @relation(fields: [outletId], references: [id], onDelete: Restrict)
  user   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderStatusEvent[]

  @@index([outletId, businessDate, status])
  @@index([userId, placedAt])
  @@index([status, placedAt])
  /// Drives the lapse sweep: "which unpaid orders are past their window?" runs on every store
  /// status read, so it must not become a table scan as the order table grows.
  @@index([status, paymentExpiresAt])
  @@map("orders")
}

/// Prices are snapshotted here (ADR-011) — a menu edit must never change a placed order.
model OrderItem {
  id                String @id @default(cuid())
  orderId           String @map("order_id")
  productId         String? @map("product_id")
  variantId         String? @map("variant_id")
  nameSnapshot      String @map("name_snapshot")
  variantNameSnapshot String? @map("variant_name_snapshot")
  /// JSON array of selected add-on names.
  addOnsJson        String @default("[]") @map("add_ons_json")
  unitPricePaise    BigInt @map("unit_price_paise")
  quantity          Int
  lineTotalPaise    BigInt @map("line_total_paise")
  note              String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// Full audit trail of the lifecycle — written by the state machine, never by a controller.
model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorRole  String?  @map("actor_role")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}
