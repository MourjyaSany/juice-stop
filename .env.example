####################################################################################################
# Juice Stop — environment template
#
#   cp .env.example .env
#
# NEVER commit .env. Real secrets live in Doppler / the provider's secret store (09-deployment.md §7).
# Every variable here is validated by a Zod schema at boot; the API refuses to start if any is
# missing or malformed. Fail loudly at 18:00, never silently at 23:30.
####################################################################################################

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ROLE=api                       # api | realtime | worker
PORT=3000
REALTIME_PORT=3001
LOG_LEVEL=debug                    # fatal|error|warn|info|debug|trace
TZ=UTC                             # Always UTC. IST is a rendering concern (02-data-model.md §1).

# ── URLs ─────────────────────────────────────────────────────────────────────────────────────────
API_URL=http://localhost:3000
WEB_URL=http://localhost:3100
KITCHEN_URL=http://localhost:3101
RIDER_URL=http://localhost:3102
ADMIN_URL=http://localhost:3103
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# SQLite — a single file on disk, no containers. Path is relative to packages/db/prisma/.
DATABASE_URL=file:./dev.db
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── Redis ────────────────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=js:dev

# ── Auth (ADR: 01-system-architecture.md §10) ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_dev_only_refresh_secret_min_32_chars
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL_CUSTOMER=30d
JWT_REFRESH_TTL_STAFF=12h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                # MUST be true in production
CSRF_SECRET=CHANGE_ME_dev_only_csrf_secret_min_32_chars

# ── OTP ──────────────────────────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_BYPASS_CODE=000000         # dev only — the Zod schema REJECTS this in production

# ── Payments — Razorpay (ADR-005, ADR-014) ───────────────────────────────────────────────────────
# Test-mode keys only outside production. Boot asserts live keys are never used in non-prod.
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
PAYMENT_ORDER_EXPIRY_MINUTES=10

# ── Store configuration (01-system-architecture.md §9) ───────────────────────────────────────────
STORE_TIMEZONE=Asia/Kolkata
STORE_OPEN_TIME=19:00
STORE_CLOSE_TIME=04:00
BUSINESS_DATE_OFFSET_HOURS=5       # cutover at 05:00 IST — must exceed close time (ADR-010)

# ── Capacity (ADR-013) ───────────────────────────────────────────────────────────────────────────
CAPACITY_SLOT_MINUTES=10
CAPACITY_WARN_THRESHOLD=0.80       # warn + show wait estimate before checkout
CAPACITY_PAUSE_THRESHOLD=1.00      # stop accepting new orders
CAPACITY_OVERRIDE_TTL_MINUTES=30   # admin override auto-expires

# ── Geo (ADR-004) ────────────────────────────────────────────────────────────────────────────────
FEATURE_STRICT_GPS_GATING=false    # LOCKED OFF — serviceability uses the verified delivery address
GPS_FRAUD_FLAG_DISTANCE_KM=3       # flag for review, never block
GOOGLE_MAPS_API_KEY=

# ── Media ────────────────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=juicestop-dev
S3_ACCESS_KEY_ID=juicestop
S3_SECRET_ACCESS_KEY=juicestop_dev
S3_FORCE_PATH_STYLE=true           # required by MinIO; false for S3/Spaces
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Juice Stop <orders@juicestop.in>"
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JUICES
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@juicestop.in

# ── Observability ────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=juice-stop-api

# ── Business identity (invoices — 02-data-model.md §4.7) ─────────────────────────────────────────
BUSINESS_LEGAL_NAME="Juice Stop"
BUSINESS_GSTIN=
BUSINESS_FSSAI_LICENSE=
BUSINESS_PLACE_OF_SUPPLY=33        # Tamil Nadu
BUSINESS_ADDRESS="Kattankulathur, Chengalpattu, Tamil Nadu"
