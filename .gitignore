# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/

# environment — NEVER commit real secrets (ADR-017 / 09-deployment.md §7)
.env
.env.*
!.env.example
*.pem
*.key

# test & coverage
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# os
.DS_Store
Thumbs.db
desktop.ini

# local infra volumes
infra/docker/data/

# prisma — the client is generated from schema.prisma on every build
packages/db/generated/
# The SQLite database itself is local state, rebuilt with `pnpm db:migrate && pnpm db:seed`.
# Migrations ARE committed; the data file is not.
packages/db/prisma/*.db
packages/db/prisma/*.db-journal
packages/db/prisma/migrations/dev.db*

# misc
.cache/
tmp/
